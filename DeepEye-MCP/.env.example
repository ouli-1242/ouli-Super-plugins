# DeepEye 配置示例
# 复制本文件为 .env 并按需填写 API Key。

# 视觉后端提供者：openai / gemini / custom（三类均已实现可切换）
VISION_PROVIDER=openai

# ---------- OpenAI 兼容后端 ----------
# OpenAI API Key（必填，使用 OpenAI 或兼容服务时）
OPENAI_API_KEY=
# 模型名称（必须支持图片/视觉输入，见 README「各厂商 base_url 参考」）
OPENAI_MODEL=gpt-5.6-luna
# 接口地址，留空则使用官方 https://api.openai.com/v1
# 任意 OpenAI 兼容厂商都可填这里，例如：
#   阿里通义:  https://dashscope.aliyuncs.com/compatible-mode/v1   (qwen-vl-max)
#   阶跃星辰:  https://api.stepfun.com/step_plan/v1               (step-3.7-flash)
#   智谱 GLM:  https://open.bigmodel.cn/api/paas/v4               (glm-4v-plus)
#   Kimi:      https://api.moonshot.cn/v1
#   本地 Ollama: http://127.0.0.1:11434/v1                        (llava 等)
#   本地 vLLM:   http://127.0.0.1:8000/v1
OPENAI_BASE_URL=

# ---------- Gemini 后端（可用） ----------
# 使用 Google Gemini generateContent API，端点默认为
# https://generativelanguage.googleapis.com/v1beta
# （也可用 VISION_PROVIDER=gemini-interactions 走新版 Interactions API，
#   复用同样的 GEMINI_API_KEY / GEMINI_MODEL / GEMINI_BASE_URL）
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-pro

# ---------- Anthropic 后端（可用） ----------
# Claude 视觉模型（高质量档：UI 布局还原 / 表格抽取 / 高分辨率截图）。
# 使用原生 Messages API，大陆访问需代理 + 国际支付。
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
ANTHROPIC_BASE_URL=https://api.anthropic.com/v1

# ---------- OpenAI Responses API 后端（可用） ----------
# 走 OpenAI 官方 Responses 协议（/v1/responses）。
# 主要用于 OpenAI 官方 gpt-5 系列；第三方兼容厂商多用 Chat Completions。
RESPONSES_API_KEY=
RESPONSES_MODEL=gpt-5.6
RESPONSES_BASE_URL=https://api.openai.com/v1

# ---------- OCR 后端 ----------
# extract_text 工具实际使用的视觉后端：openai / gemini / custom
OCR_BACKEND=openai

# ---------- 性能优化 ----------
# 图片预处理：图片最大边长，超过则等比缩放并转 JPEG；0 表示禁用预处理
IMAGE_MAX_DIM=2048
# 是否开启视觉识别结果缓存（命中可避免重复调用后端）
CACHE_ENABLED=true
# 缓存最大条目数（LRU 淘汰最旧条目）
CACHE_MAX_SIZE=128
# 缓存存活秒数（TTL，过期视为未命中）
CACHE_TTL=3600

# ---------- 网络请求 ----------
# 视觉后端 HTTP 请求超时（秒）
REQUEST_TIMEOUT=120
# 失败重试次数（仅对网络/超时错误重试，不对 4xx 重试）
MAX_RETRIES=3
# 视觉模型返回的最大 token 数
MAX_TOKENS=4096
# 推理深度：low / medium / high；留空则不发送该参数（部分后端不支持）
REASONING_EFFORT=

# ---------- 图片 URL 下载 ----------
# 下载图片的最大字节数，超过则拒绝（防止内存耗尽）
MAX_IMAGE_BYTES=20971520
# 是否允许访问内网/保留地址（默认禁止，防止 SSRF；仅本地调试时设为 true）
ALLOW_PRIVATE_URLS=false
